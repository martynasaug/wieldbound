node_modules/
dist/
build/

# The SQLite "database" is local runtime state — characters, items, positions.
# It is also 4MB of WAL most of the time. Everyone who clones gets a fresh
# one created on first server start (see server/src/db.ts).
server/data/

*.log
.env
.env.*
.DS_Store
Thumbs.db
.vscode/
.idea/

# Fetched source SVGs for tools/art/icons.mjs. The baked output
# (client/src/ui/icons.ts) is what the game uses and IS committed; this is just
# a cache so re-running the generator does not re-download 120 files.
tools/art/.icon-cache/

# tsc -b writes these beside the config; they are a build cache.
*.tsbuildinfo
